FROM ubuntu:24.04
# ansible-core 2.22 needs Python 3.13 on the controller; 24.04 ships 3.12.
ARG ANSIBLE_CORE=2.21.6
RUN apt-get update && apt-get install -y --no-install-recommends systemd systemd-sysv python3 python3-pip python3-venv python3-apt ca-certificates \
    && python3 -m venv --system-site-packages /opt/ansible && /opt/ansible/bin/pip install --no-cache-dir "ansible-core==$ANSIBLE_CORE" \
    && rm -rf /var/lib/apt/lists/*
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
